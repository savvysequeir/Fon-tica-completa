          ".write": "auth != null && auth.uid === 'aqks8iG8JDT4caWNXqnRyWGYaaG2'",
          ".validate": "newData.hasChildren(['sourceSessionId','date','createdAt','expiresAt','createdBy','students']) && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now"
