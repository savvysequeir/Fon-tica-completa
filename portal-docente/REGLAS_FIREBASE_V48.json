            ".write": "!data.exists() && root.child('qrAttendance/sessions/'+$sessionId+'/expiresAt').val() > now && root.child('qrAttendance/sessions/'+$sessionId+'/students/'+$cardKey+'/card').val() === newData.child('card').val()",
            ".validate": "newData.hasChildren(['card','at','method']) && newData.numChildren() === 3 && newData.child('card').isString() && newData.child('card').val().length > 0 && newData.child('card').val().length <= 60 && newData.child('at').isNumber() && newData.child('method').val() === 'QR Internet'"
